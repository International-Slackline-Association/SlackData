                  "const rows = pm.response.json();",
                  "pm.test('all from the one batch', () => pm.expect(rows.every(r => r.batch_id === pm.collectionVariables.get('batchId'))).to.be.true);",
                  "console.log('items stored in this batch:', rows.length);"
                ]
              }
            }
          ]
