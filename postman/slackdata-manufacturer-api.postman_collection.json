                  "const mine = rows.filter(r => r.kind === 'manufacturer');",
                  "pm.test('manufacturer submissions are there', () => pm.expect(mine.length).to.be.above(0));",
                  "if (mine.length) {",
                  "  pm.test('never expires', () => pm.expect(mine[0].expires_at).to.eql(null));",
                  "  pm.test('nobody reviewed it', () => pm.expect(mine[0].reviewed_at).to.eql(null));",
