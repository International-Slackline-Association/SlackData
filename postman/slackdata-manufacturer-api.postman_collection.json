              }
            }
          ]
        },
        {
          "name": "403 \u2014 unregistered or revoked client",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}:not-a-real-client"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/manufacturer/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "manufacturer",
                "me"
              ]
            },
            "description": "403, not 401: the token is genuine and re-authenticating produces the same one \u2014 it is simply not registered to a brand, or no longer is. `register.py --deactivate` takes effect on the very next request; the client record is never cached, because revocation that takes effect \"eventually\" is not revocation."
          },
          "event": [
