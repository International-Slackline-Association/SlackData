  "gearType": "WEB",
  "manufacturer": "Aki Slacklines",
  "creatorId": "10213773283512968",
  "text": "I like the fact that you can tension it really easily, before I bought a pulley system I managed to use a primitive system to tension a 60m line with about 3m of sag with no problems what so ever. \nI think its not very versatile because of it's low stretch, even when you tension it a lot it doesn't feel very stretchy and playable.\nOverall this line is great, I've had it for about a year and a half, and it's been used for around 3 years, used it for highline several times and it work out great.",
  "rating": {
   "lst": {
    "VFM": 8,
    "QU": 8,
    "VER": 4,
    "EOU": 10,
    "SFT": 6
   },
   "overall": 7
  },
  "pros": [
   "Very easy to tension",
   "Doesn't take a lot of room",
   "Fairly visible",
   "Great grip, doesn't slip at all"
  ],
  "cons": [
   "Not very versatile",
   "Edges become sharp under high tension"
  ],
  "creationDate": 1500305241185,
  "creatorName": "Raz Rimon"
 },
