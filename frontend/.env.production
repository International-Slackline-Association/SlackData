# Production build config.
#
# The hosted site is served from S3/CloudFront, where the API lives under /api on
# the SAME CloudFront domain (a CloudFront Function strips the prefix before the
# request reaches Lambda — see infra/). So the SPA calls the API same-origin at
# /api, with no separate API host and no CORS.
# (See frontend/src/api/client.ts — the `?? 'http://localhost:8000'` fallback
# only applies when the var is undefined, so this value is used as-is.)
VITE_API_URL=/api

# ── Phase 2: submissions + admin triage ──────────────────────────────────────
# Vite inlines these at BUILD time, so the frontend must be rebuilt (deploy half
# B) after any change here — and the three values below are only knowable AFTER
# half A has created the Cognito pool. See infra/README.md § Turning Phase 2 on.
VITE_ENABLE_SUBMISSIONS=true

# Cloudflare Turnstile, public site key (the matching secret is exported to the
# Lambda at deploy time and is never committed).
#
# If this is left empty the suggestion form stays HIDDEN rather than shipping a
# form the API would reject every submission from — see SuggestButton.tsx. That
# is deliberate: a missing key should cost the feature, not break it in public.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEare6yBsU1sol9D

# Cognito admin login. Fill from the stack outputs after half A:
#   AdminUserPoolId       -> https://cognito-idp.eu-central-1.amazonaws.com/<pool id>
#   AdminUserPoolClientId -> VITE_COGNITO_CLIENT_ID
# Left empty, /admin renders "sign-in is not configured" rather than a dev-token
# prompt that the API would reject.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
