# Production build config.
#
# The hosted site is served from S3/CloudFront, where the API lives under /api on
# the SAME CloudFront domain (a CloudFront Function strips the prefix before the
# request reaches Lambda — see infra/). So the SPA calls the API same-origin at
# /api, with no separate API host and no CORS.
# (See frontend/src/api/client.ts — the `?? 'http://localhost:8000'` fallback
# only applies when the var is undefined, so this value is used as-is.)
VITE_API_URL=/api

# Vite inlines these at BUILD time, so the frontend must be rebuilt (deploy half
# B) after any change here.

# Sign-in: the ISA's shared pool, `isa-users`, and SlackData's own app client in
# it (LIVE_EDITING_PLAN.md D61). Public values — both are in every ID token.
# ./infra/sync-env.sh writes the first two from the stack outputs IsaUserPoolId
# and IsaClientId. Left empty, sign-in renders "not configured" rather than a
# dev-token prompt that the API would reject. SlackData has no pool of its own
# any more (D62).
VITE_ISA_AUTHORITY=https://cognito-idp.eu-central-1.amazonaws.com/eu-central-1_iGaYGKeyJ
VITE_ISA_CLIENT_ID=2snjdh8i6md0m5n6h9te1hlor1
# The ISA's hosted sign-in, used to sign out of it too.
VITE_ISA_DOMAIN=auth.slacklineinternational.org
