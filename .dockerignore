# Keep the Docker build context small. This applies to the Lambda image build
# (Dockerfile.lambda). The SPA is not part of the API image, and the catalog DB
# is baked at build time, so neither ships from the local tree.
.git
.gitignore
**/__pycache__
**/*.py[cod]
.pytest_cache
.venv
venv
*.db
*.egg-info
slackdata.egg-info

# Frontend deps/build — the API image doesn't include the website.
frontend/node_modules
frontend/dist

# Local/dev-only material not needed at runtime.
scraper
scripts/.cache
scratchpad_dl
