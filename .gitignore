# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
venv/
.venv/
*.db

# Node dependencies. frontend/.gitignore covers the frontend's copy; this catches
# every other one — notably infra/, which gets a node_modules once the pinned
# Serverless Framework is installed (see infra/README.md).
node_modules/

# Serverless Framework's per-deploy build output (packaged artifacts + the
# resolved CloudFormation template it uploads). Regenerated on every deploy.
.serverless/

# Scraper output (images + manifests)
scraper/
scripts/.cache/

# Local gear-status provenance (working set for the active-field pass; not runtime input)
# Gear-status web-verification working set. Provenance for the `active` field
# only — nothing at runtime reads it; the values it produced are baked into the
# root <type>s.json seeds.
gear_status/
